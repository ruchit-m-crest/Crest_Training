   "source": [
    "## 1.program to find numbers from a string"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "faa318e7-ce01-4d49-be71-ac8aefe95062",
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "\n",
    "def number_matcher(text):\n",
    "    \n",
    "    pattern = r'\\d+'\n",
    "    matches = re.findall(pattern, text)\n",
    "    \n",
    "    if matches:\n",
    "        print(\" \".join(matches))\n",
    "    else:\n",
    "        print(-1)\n",
    "\n",
    "\n",
    "str\n"
   ]
