   "source": [
    "## 1. Sum of Digits of power"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "4c621615-49f7-4731-a547-36d3358cddaf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "115\n",
      "37\n"
     ]
    }
   ],
   "source": [
    "def power_base_sum(base, power):\n",
    "    return sum([int(i) for i in str(pow(base, power))])\n",
    "\n",
    "\n",
    "print(power_base_sum(2, 100))\n",
    "print(power_base_sum(8, 10))\n"
   ]
