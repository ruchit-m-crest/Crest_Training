   "source": [
    "import json\n",
    "\n",
    "python_obj = {\n",
    "  \"name\": \"David\",\n",
    "  \"class\":\"I\",\n",
    "  \"age\": 6  \n",
    "}\n",
    "print(type(python_obj))\n",
    "\n",
    "j_data = json.dumps(python_obj)\n",
    "\n",
    "\n",
    "print(j_data)\n"
   ]
