   "source": [
    "## 1.Find most common elements and counts in a text"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "9759a239-38a8-4cf3-b900-0d8f9bbf00e3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original string: aswdfghktrtvstetnuyfvtredrtfdgawrxawar\n",
      "Most common three characters of the said string:\n",
      "[('t', 6), ('r', 5), ('a', 4)]\n"
     ]
    }
   ],
   "source": [
    "from collections import Counter\n",
    "\n",
    "s = 'aswdfghktrtvstetnuyfvtredrtfdgawrxawar'\n",
    "\n",
    "print(\"Original string: \" + s)\n",
    "\n",
    "print(\"Most common three characters of the said string:\")\n",
    "\n",
    "print(Counter(s).most_common(3)) \n"
   ]
  },
