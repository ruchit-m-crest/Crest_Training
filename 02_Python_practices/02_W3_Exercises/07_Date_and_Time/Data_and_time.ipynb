    "## 2. Number of days in a given month"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "c13fd2cd-f8a7-44c9-9c8d-0ee3063fe9b4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(calendar.FRIDAY, 31)\n"
     ]
    }
   ],
   "source": [
    "from calendar import monthrange\n",
    "\n",
    "year = 2025\n",
    "month = 8\n",
    "\n",
    "print(monthrange(year, month\n",
    "                ))"
   ]
