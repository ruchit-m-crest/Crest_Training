   "id": "aed14acf-9cab-4b16-8198-5b076918dd44",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "22 days, 0:00:00\n"
     ]
    }
   ],
   "source": [
    "from datetime import date\n",
    "\n",
    "a = date(2025, 7, 2)\n",
    "b = date(2025, 7, 24)\n",
    "\n",
    "print(b-a)"
   ]
