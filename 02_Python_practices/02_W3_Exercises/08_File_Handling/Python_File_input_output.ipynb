   "source": [
    "## 1. Generate 26 text files named A.txt, B.txt, and so on"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "4789c0e0-d89d-46de-8f1d-47663025c758",
   "metadata": {},
   "outputs": [],
   "source": [
    "import string, os\n",
    "\n",
    "if not os.path.exists('letters'):\n",
    "    os.makedirs('letters')\n",
    "\n",
    "for letter in string.ascii_uppercase:\n",
    "    with open(letter + '.txt', 'w') as f:\n",
    "        f.writelines(letter)"
   ]
