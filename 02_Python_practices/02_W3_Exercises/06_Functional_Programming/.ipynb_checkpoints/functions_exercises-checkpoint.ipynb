     "text": [
      "15\n"
     ]
    }
   ],
   "source": [
    "def test(a):\n",
    "    def add(b):\n",
    "        nonlocal a\n",
    "        a += 1\n",
    "        return a + b\n",
    "    return add\n",
    "\n",
    "func = test(7)\n",
    "print(func(7))\n"
   ]
